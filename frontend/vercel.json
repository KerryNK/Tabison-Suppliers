{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
  {
    "source": "/(.*)",
    "destination": "/index.html"
  },
  {
    "source": "/api/.*",
    "destination": "https://tabison-suppliers.onrender.com",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
